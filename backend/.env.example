APP_PORT=8080
APP_ENV=development

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=pdf_tools
DATABASE_SSLMODE=disable

STORAGE_UPLOAD_DIR=./storage/uploads
STORAGE_OUTPUT_DIR=./storage/outputs

MAX_FILE_SIZE_MB=50

# Options: ghostscript | qpdf | auto
COMPRESSOR_ENGINE=ghostscript

# Optional explicit binary paths (leave blank to use PATH)
GHOSTSCRIPT_BINARY=
QPDF_BINARY=

COMPRESS_TIMEOUT_SECONDS=120
RATE_LIMIT_MAX=100
RATE_LIMIT_DURATION_SECONDS=60
